# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-15
# Viewer token: draft mode, live preview (server only)
SANITY_API_READ_TOKEN=
# Editor token: saving enquiries, seeding (server only, never exposed)
SANITY_API_WRITE_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (spam protection). Leave empty in dev to skip.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (optional email notification for enquiries)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
